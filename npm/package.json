{
  "name": "@somewhere-tech/sessions",
  "version": "0.2.29",
  "description": "The native Go Sessions CLI, daemon, and durable runner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Somewhere-Tech/sessions.git",
    "directory": "npm"
  },
  "homepage": "https://sessions.somewhere.tech",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "bin": {
    "sessions": "bin/sessions.cjs",
    "sessionsd": "bin/sessionsd.cjs",
    "sessions-runner": "bin/sessions-runner.cjs"
  },
  "files": [
    "bin/",
    "lib/",
    "install.cjs",
    "release-manifest.json",
    "scripts/verify-release.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node install.cjs",
    "prepublishOnly": "node scripts/verify-release.cjs",
    "test": "node --test test/*.test.cjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
