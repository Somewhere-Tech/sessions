{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeBuildCommand": "npm --prefix frontend run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-app-runtime.ps1"
  },
  "bundle": {
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "./windows/installer-header.bmp",
        "sidebarImage": "./windows/installer-sidebar.bmp",
        "installerIcon": "./icons/icon.ico",
        "uninstallerIcon": "./icons/icon.ico",
        "uninstallerHeaderImage": "./windows/installer-header.bmp"
      }
    }
  }
}
